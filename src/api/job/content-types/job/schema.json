{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "sammiCode": {
      "type": "uid",
      "default": "SAMMI10001",
      "regex": "^SAMMI\\d{5}$"
    },
    "Title": {
      "type": "string"
    },
    "Channels": {
      "type": "enumeration",
      "enum": [
        "NL",
        "HN"
      ]
    },
    "Count": {
      "type": "integer"
    },
    "Categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "Job"
    },
    "Picture": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
